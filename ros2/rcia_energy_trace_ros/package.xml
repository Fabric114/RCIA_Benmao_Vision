<?xml version="1.0"?>
<package format="3">
  <name>rcia_energy_trace_ros</name>
  <version>0.1.0</version>
  <description>ROS2 bridge for RCIA Energy Trace FoundationPose initialization and M3T tracking.</description>
  <maintainer email="benmao@example.com">benmao</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>message_filters</depend>
  <depend>librealsense2</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
